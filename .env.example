# JARVIS settings. Copy to .env (setup.sh does this for you), edit, then `docker compose up -d`.
# Docker Compose reads these for compose.yaml. Keep .env private: it can hold the voice key and a password.
#
# Model provider keys don't go here: the dashboard's GUIDE saves them in Hermes's own .env (in the data volume), and
# for your own Hermes they live in its ~/.hermes/.env.

# The key that unlocks the JARVIS, Ultron and Cortana voices built into the image (whoever shared JARVIS with you has
# it). Without it JARVIS uses its original voices.
JARVIS_VOICE_KEY=

# JARVIS asks for a password before anything else, and the first visit creates it. To set it here instead:
# JARVIS_PASSWORD=

# Address the port listens on. 0.0.0.0 (default) = every network interface, so other devices at home can open JARVIS
# (with its password). 127.0.0.1 = this computer only.
JARVIS_BIND=0.0.0.0

# Setup screen, dashboard (/vesper) and browser desktop (/desktop/): http://<this computer>:8642
JARVIS_PORT=8642

# Where JARVIS and Hermes keep everything. Default: the Docker volume "jarvis-data". Or a host folder, e.g.
# JARVIS_DATA=/srv/jarvis/data   (owned by uid 10001, or by root: JARVIS hands it to uid 10001 on start)
# JARVIS_DATA=jarvis-data

# Time zone (IANA name, e.g. Europe/London or America/New_York). Cron jobs and reminders run on it.
TZ=UTC

# When JARVIS installed Hermes: install new stable Hermes releases automatically, daily at this hour (container time).
# These are the defaults for the first run; the setup screen's Updates card changes them afterwards.
JARVIS_AUTO_UPDATE=1
JARVIS_AUTO_UPDATE_HOUR=4

# "I already have Hermes": extra networks to search (comma-separated), and addresses to try first.
# JARVIS_SCAN_SUBNETS=192.168.1.0/24
# JARVIS_HERMES_URLS=http://192.168.1.20:8642

# The address your Hermes should use to reach JARVIS (for the connect prompt), if it differs from the one in your
# browser, e.g. when you open JARVIS through Tailscale but Hermes is on the LAN.
# JARVIS_PUBLIC_URL=http://192.168.1.10:8642

# The image. Default: the published one (ghcr.io/recl1p/jarvis:2, x86-64).
# JARVIS_IMAGE=ghcr.io/recl1p/jarvis:2
# Building it yourself (./setup.sh --build): pocket (default) = Pocket TTS voices; 1 = also OmniVoice (about 9 GB
# more); 0 = no self-hosted voices.
# JARVIS_LOCAL_VOICES=pocket
